    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.90.7",
    "expo": "^54.0.23",
    "expo-constants": "~18.0.10",
    "expo-device": "~8.0.9",
    "expo-font": "^14.0.9",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
